# ---------------------------------------------------------------------------
# McKesson Deployment Tool - configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Where this dashboard listens -------------------------------------------
# Keep the host on 127.0.0.1: this process holds app-server credentials and
# must not be reachable from the network.
APP_HOST=127.0.0.1
APP_PORT=5002


# --- Safety -----------------------------------------------------------------
# Leave DRY_RUN=true until you have validated the tool end to end.
# In dry-run nothing on the server is modified, uploaded, restarted or killed.
DRY_RUN=true

# In dry-run, whether to still open a real SSH session so read-only checks
# (connectivity, sudo, existing files) are exercised against the real server.
# Start with false so the app runs fully offline before SSH is configured,
# then set it to true once SSH_KEY_PATH works to rehearse a real deployment.
DRY_RUN_CONNECT=false


# --- McKesson app server ----------------------------------------------------
SSH_HOST=vm-mms-cims02.na.corp.mckesson.com
# Optional fallback if DNS is unavailable from the VDI.
SSH_ADDRESS=10.15.128.5
SSH_PORT=22
SSH_USERNAME=day6sio

# Preferred: SSH key authentication. Example:
#   SSH_KEY_PATH=C:/Users/day6sio/.ssh/id_rsa
# Leave empty to use the SSH agent / default keys in ~/.ssh.
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=

# Fallback only. NEVER hardcode this anywhere but your local .env file.
SSH_PASSWORD=

# Host key policy: strict (recommended) | auto_add
SSH_HOST_KEY_POLICY=strict
SSH_KNOWN_HOSTS=

SSH_CONNECT_TIMEOUT=20
SSH_COMMAND_TIMEOUT=120


# --- Privilege escalation ---------------------------------------------------
# The manual process uses `sudo -i`. Set USE_SUDO=false only if day6sio already
# owns the binaries directory and can manage systemd without escalation.
USE_SUDO=true
# Leave empty when the account has NOPASSWD sudo (preferred).
SUDO_PASSWORD=


# --- Installation API -------------------------------------------------------
INSTALLATION_HUB_URL=http://demo.aidap.aidendigital.com:8081/api/installation-hubs/path
INSTALLATION_CODE=
DOWNLOAD_TIMEOUT=300

# Fallback for when the installation hub is down. When true, the JAR is NOT
# downloaded - it must already be present in TEMP_DIR under its exact name,
# e.g. temp/deployments/tx-integration-agent-1.6.0.jar
# The file is validated (must be a real JAR) and its SHA-256 is logged.
# It is never deleted after a successful deployment.
USE_LOCAL_JAR=false


# --- Remote layout ----------------------------------------------------------
REMOTE_BINARIES_DIR=/home/AidenAI/binaries
REMOTE_SYSTEMD_DIR=/etc/systemd/system
REMOTE_COPYDATA_DIR=/home/day6sio/CopyData
REMOTE_WEBDAV_DIR=/var/www/webdav

# Backup folder layout:
#   nested -> /home/AidenAI/binaries/backups/2026-08-14/   (recommended)
#   flat   -> /home/AidenAI/binaries/Aug14/                (existing convention)
BACKUP_LAYOUT=nested
BACKUP_ROOT=/home/AidenAI/binaries/backups
# strftime format for the dated folder. nested default: %Y-%m-%d, flat: %b%d
BACKUP_DATE_FORMAT=%Y-%m-%d

# Also stage the uploaded JAR in CopyData/<date>/ the way the manual run does.
STAGE_IN_COPYDATA=true


# --- Checksum validation ----------------------------------------------------
# Regex the pasted checksum must match. The Aiden build publishes SHA-256
# digests (64 hex characters), which is what the default accepts.
# Whitespace, quotes and shell metacharacters are always rejected.
CHECKSUM_PATTERN=^[a-fA-F0-9]{64}$


# --- Logs -------------------------------------------------------------------
LOG_TAIL_LINES=200
HEALTH_CHECK_DELAY=8


# --- Local ------------------------------------------------------------------
TEMP_DIR=temp/deployments
# Keep the downloaded JAR after a successful deployment (default: delete it).
KEEP_TEMP_FILES=false
AUDIT_LOG=temp/deployments.log
